{
  "name": "jolt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "shoot": "node tools/shoot.mjs",
    "playtest": "node tools/playtest.mjs",
    "playtest:latency": "node tools/playtest-latency.mjs",
    "test": "node --test tests/input.test.mjs tests/content.test.mjs tests/mastery.test.mjs tests/audio.test.mjs tests/shellui.test.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  }
}